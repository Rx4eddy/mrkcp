# Server Configuration
PORT=5000
NODE_ENV=development
APP_URL=http://localhost:5173
API_URL=http://localhost:5000

# Database (SQLite default for zero-config run, or postgres://user:pass@host:5432/mrkcp)
DATABASE_URL="file:./dev.db"

# JWT Secret for Sessions
JWT_SECRET=super-secret-mrkcp-jwt-key-change-in-production-min32chars
JWT_EXPIRES_IN=7d

# ==============================================================================
# Live Email Delivery Options (Choose ONE to send real emails to inboxes)
# ==============================================================================

# Option A: Resend (Recommended & Easiest, 3,000 free emails/mo: https://resend.com)
RESEND_API_KEY=
RESEND_FROM="mrkcp <onboarding@resend.dev>"

# Option B: Gmail (Free & Instant using Google App Password)
# 1. Enable 2-Step Verification in Google Account
# 2. Generate an App Password at: https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Option C: Standard SMTP (SendGrid, Brevo, AWS SES, Mailgun, custom server)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="mrkcp Contests <notifications@mrkcp.dev>"

# ==============================================================================
# Scheduler Cron Schedules
# ==============================================================================
# Contest Fetcher Schedule (Cron format, default: every 30 minutes)
CONTEST_CRON_SCHEDULE="*/30 * * * *"

# Reminder Checker Schedule (Cron format, default: every 5 minutes)
REMINDER_CRON_SCHEDULE="*/5 * * * *"
